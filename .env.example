# Copy this file to .env and fill in the values. NEVER commit .env.

# Google Cloud API key (Vision + Speech-to-Text). See docs/GOOGLE_SETUP.md.
GOOGLE_API_KEY=

# Providers: "auto" uses Google when GOOGLE_API_KEY is set and a simulated
# provider ("mock") otherwise. Valid values: auto | google | mock
EMOTION_PROVIDER=auto
SPEECH_PROVIDER=auto

# Speech recognition language (es-CR = Costa Rican Spanish; alternative: es-419)
SPEECH_LANGUAGE=es-CR

WAKE_WORD=jarvistec

# Mock mode only
MOCK_TRANSCRIPT=JarvisTEC precio del bitcoin
# MOCK_EMOTION=happiness

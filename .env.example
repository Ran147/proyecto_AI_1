# Copy this file to .env. NEVER commit .env.
# Nothing here is required: without a key the web interface transcribes in the
# browser and the emotion comes from the local model.

# Google Cloud API key (Vision + Speech-to-Text). Optional; see
# docs/GOOGLE_SETUP.md.
GOOGLE_API_KEY=

# Emotion provider. "auto" uses Google when GOOGLE_API_KEY is set, otherwise
# the local model, otherwise a simulated answer.
# Valid values: auto | local | google | mock
EMOTION_PROVIDER=auto

# Classifier of the local emotion provider: ensemble (FER+ and HSEmotion
# averaged, default) | ferplus | hsemotion
# EMOTION_MODEL=ensemble

# Speech provider of POST /transcribe. "auto" uses Google when GOOGLE_API_KEY
# is set; otherwise the server has no speech engine ("browser") and the web
# interface uses the browser's speech recognition.
# Valid values: auto | google | browser | mock
SPEECH_PROVIDER=auto

# Language of Google Speech-to-Text (the commands are in English).
SPEECH_LANGUAGE=en-US

WAKE_WORD=jarvistec

# Mock providers only (development and tests)
# MOCK_TRANSCRIPT=JarvisTEC bitcoin price
# MOCK_EMOTION=happiness

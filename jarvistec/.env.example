# Copien este archivo a .env y completen los valores. NUNCA suban .env al repo.

# Clave de API de Google Cloud (Vision + Speech-to-Text). Ver docs/CONFIGURAR_GOOGLE.md
GOOGLE_API_KEY=

# Proveedores: "auto" usa Google si hay GOOGLE_API_KEY y, si no, un modo simulado ("mock").
# Valores válidos: auto | google | mock
EMOTION_PROVIDER=auto
SPEECH_PROVIDER=auto

# Idioma de reconocimiento de voz (es-CR = español de Costa Rica; alternativa: es-419)
SPEECH_LANGUAGE=es-CR

WAKE_WORD=jarvistec

# Solo para el modo simulado (mock)
MOCK_TRANSCRIPT=JarvisTEC precio del bitcoin
# MOCK_EMOTION=happiness
